# 결혼식 정보
NEXT_PUBLIC_GROOM_NAME=신랑이름
NEXT_PUBLIC_BRIDE_NAME=신부이름
NEXT_PUBLIC_WEDDING_DATE=YYYY-MM-DD
NEXT_PUBLIC_WEDDING_TIME=HH:MM
NEXT_PUBLIC_WEDDING_PLACE=예식장이름
NEXT_PUBLIC_WEDDING_ADDRESS=예식장주소
NEXT_PUBLIC_WEDDING_LAT=위도
NEXT_PUBLIC_WEDDING_LNG=경도

# 배경 음악
NEXT_PUBLIC_MUSIC_URL_1=https://example.com/music1.mp3
NEXT_PUBLIC_MUSIC_URL_2=https://example.com/music2.mp3

# 계좌 정보
NEXT_PUBLIC_ACCOUNT_GROOM=은행명|예금주|계좌번호
NEXT_PUBLIC_ACCOUNT_BRIDE=은행명|예금주|계좌번호

# 기타 정보
NEXT_PUBLIC_PARKING_INFO=주차 안내 텍스트
NEXT_PUBLIC_TRANSPORT_INFO=대중교통 안내 텍스트

# Google API (Service Account JSON)
GOOGLE_SHEETS_ID=your_sheets_id_here
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
GOOGLE_SERVICE_ACCOUNT={"type":"service_account"}

# 지도 API
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_key_here
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_client_id_here
